## Phase 4: Virtual Microphone Core

### 4.1 VirtualMicrophone Class
```typescript
// src/virtual-mic/VirtualMicrophone.ts
export class VirtualMicrophone {
  private delayMs: number;
  private delayBuffer: Float32Array;
  private bufferIndex: number = 0;
  private inputDevice: number;
  private outputDevice: number;
  private isRunning: boolean = false;
  private engine: AudioEngine;

  constructor(
    delayMs: number,
    inputDevice: number,
    outputDevice: number,
    engine: AudioEngine
  ) {
    this.delayMs = delayMs;
    this.engine = engine;
    // Calculate buffer size: delayMs * sampleRate / 1000
    this.delayBuffer = new Float32Array(bufferSize);
  }

  async start(): Promise<void> {
    const inputStream = await this.engine.openInputStream(this.inputDevice);
    const outputStream = await this.engine.openOutputStream(this.outputDevice);

    this.isRunning = true;

    // Process audio in real-time loop
    for await (const chunk of inputStream) {
      if (!this.isRunning) break;

      // Add to delay buffer
      const outputChunk = this.processChunk(chunk);
      await outputStream.write(outputChunk);
    }
  }

  private processChunk(input: Float32Array): Float32Array {
    const output = new Float32Array(input.length);

    for (let i = 0; i < input.length; i++) {
      // Add to circular buffer
      this.delayBuffer[this.bufferIndex] = input[i];

      // Read from buffer (delayed)
      const readIndex = (this.bufferIndex - this.delaySamples + this.bufferSize) % this.bufferSize;
      output[i] = this.delayBuffer[readIndex];

      this.bufferIndex = (this.bufferIndex + 1) % this.bufferSize;
    }

    return output;
  }

  stop(): void {
    this.isRunning = false;
    this.engine.close();
  }
}
```

