### 5.2 Main Execution Flow
```typescript
// src/index.ts
async function main(options: CLIOptions): Promise<void> {
  const engine = createAudioEngine();

  // List devices mode
  if (options.listDevices) {
    await listDevices(engine);
    return;
  }

  // Get devices
  let inputDevice = options.inputDevice;
  let outputDevice = options.outputDevice;

  if (options.autoDetect) {
    outputDevice = await findVirtualDevice(engine);
  }

  if (inputDevice === undefined) {
    inputDevice = await selectInputDevice(engine);
  }

  // Detect delay if requested
  let delayMs = parseInt(options.delay);
  if (options.detectDelay) {
    const spinner = ora("Detecting delay...").start();

    const cameraMicId = await selectDevice(engine, "Select camera microphone:");
    const computerMicId = await selectDevice(engine, "Select computer microphone:");

    delayMs = await detectDelay(
      outputDevice!,
      { id: cameraMicId },
      { id: computerMicId },
      engine
    );

    spinner.succeed(`Detected delay: ${delayMs}ms`);

    // Ask to apply
    const { apply } = await inquirer.prompt([
        {
        type: "confirm",
        name: "apply",
        message: "Apply this delay?",
        default: true
        }
    ]);

    if (!apply) process.exit(0);
  }

  // Start virtual microphone
  const virtualMic = new VirtualMicrophone(
    delayMs,
    inputDevice!,
    outputDevice!,
    engine
  );

  await virtualMic.start();
}
```

