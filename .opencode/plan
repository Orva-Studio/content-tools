// src/cli/alerts.ts
export async function showMacOSAlert(
  title: string,
  message: string,
  type: "warning" | "error" | "info" = "warning"
): Promise<boolean> {
  if (process.platform !== "darwin") return false;

  const iconMap = {
    warning: "caution",
    error: "stop",
    info: "note"
  };

  const script = `
    tell application "System Events"
      display dialog "${message}" with title "${title}" buttons {"OK"} default button "OK" with icon ${iconMap[type]}
    end tell
  `;

  const process = Bun.spawn(["osascript", "-e", script]);
  await process.exited;

  return true;
}
